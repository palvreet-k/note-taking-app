<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Notes Login</title>

    <!-- Link external CSS -->
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1 class="heading-font"> Welcome to Palvreet's Note Taking App!</h1>
    <h2 class="heading-font"> Please login to view your notes</h2>
    <form action="/login" method="POST" class="login-form">
    <label for="username">Username</label>
    <input id="username" name="username" placeholder="Enter your username" required/>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" placeholder="Enter your password" required/>
    <button name="login-btn">Login</button>
    <a href="/userSignup" class="btn auth-switch">Don't have an account? Sign Up</a>
    </form>
</body>
</html>

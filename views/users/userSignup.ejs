<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Notes Sign Up</title>

    <!-- Link external CSS -->
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <h1>Create a New Account</h1>

    <form action="/userSignup" method="POST" class="login-form">
        <input name="username" placeholder="Enter your username" required />
        <input name="password" placeholder="Enter your password" type="password" required />
        <input name="confirmPassword" placeholder="Confirm your password" type="password" required />
        <button class="btn signup-btn" name="signup-btn">Sign Up</button>
        <a href="/login" class="btn">Already have an account? Login</a>
    </form>
</body>

</html>
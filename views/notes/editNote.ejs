<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note</title>

    <!-- Link external CSS -->
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<h1 class="heading-font">Edit Note : <%= note.title %></h1>
<div class ="container">
<form action="/users/<%= note.userId %>/notes/editNote/<%= note._id%>" method = "POST" class ="note-form edit-form">
    <input name = "title" value="<%=note.title%>" required/>
    <textarea name="content" rows="6"><%= note.content %></textarea>

    <div class ="button-group">
    <button name= "update-note">Update</button>
    <a href="/users/<%= note.userId %>/notes" class="btn cancel-btn">Cancel</a>
    </div>
</form>
</div>
</body>
</html>
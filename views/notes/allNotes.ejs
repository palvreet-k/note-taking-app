<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Notes</title>

    <!-- Link external CSS -->
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <a href="/logout" class="btn signout-btn">Sign Out</a>
    <h1 class="greeting heading-font">Welcome <%= user.username %>!</h1>
    <h1 class="heading-font">Your Notes</h1>
    <div class="container notes-toolbar">
        <a href="/users/<%= user._id %>/notes/addNote" class="btn add-btn"> + Add Note</a>
    </div>
    <div class="container" id="notes">
        <% if(notes.length===0) {%>
            <p> You have no notes yet, Click "Add Notes" to start adding new notes</p>
            <%}%>
                <% notes.forEach(note=>{ %>
                    <div class="note">
                        <div class="note-header">
                            <h3>
                                <%= note.title %>
                            </h3>
                            <small>
                                <%= note.date ? new Date(note.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).replace(',', '') : '' %>
                            </small>
                        </div>
                        <p>
                            <%=note.content%>
                        </p>
                        <div class="actions">
                            <a href="/users/<%= user._id %>/notes/editNote/<%= note._id%>" class="btn edit-btn">Edit Note</a>
                            <form action="/users/<%= user._id %>/notes/deleteNote/<%= note._id %>" method="POST">
                                <button type="submit" class="btn delete-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% })%>
    </div>
</body>

</html>